# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]

# Generated data — all reproducible by rerunning the pipeline
src/data/*.parquet
src/data/*.csv
!src/data/aspect_lexicon.yaml
src/data/_checkpoints/
src/data/_models/

# Per-run provenance log (commit, GPU, batch size, library versions). Append-only
# and machine-specific, so committing it from two machines only creates conflicts.
# Ship the SERVER's copy with the artifact submission — it is the evidence for
# how every reported number was produced.
src/data/run_manifest.jsonl

# Generated figures
src/figures/*.png
src/figures/*.pdf

# Keep the gold labels — they are hand-produced and NOT reproducible
!src/data/gold_labels/*.csv

# Topic sheets stop being reproducible the moment they are hand-labelled —
# same argument as the gold labels above. Track them so the labelling survives.
!src/data/topic_info.csv
!src/data/topic_info_*.csv

# Executed notebooks. jupytext generates these from the .py percent-format files,
# which are the source of truth; the .ipynb carry megabytes of embedded output
# and re-render on every run, so they only ever produce noisy diffs.
src/notebooks/*.ipynb
